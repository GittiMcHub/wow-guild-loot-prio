# Copy to .env and fill in the ":set me" values before `docker compose up`.
# See docs/SPEC.md §3A.5 / §5 for the full rationale.

# ---- Postgres (docker-compose `db` service) ----
POSTGRES_USER=glps
POSTGRES_PASSWORD=set me
POSTGRES_DB=glps

# ---- migrate service: bootstraps the glps_migrate / glps_app roles, then
#      runs migrations. DATABASE_URL must connect as the Postgres image's
#      default superuser-ish role (POSTGRES_USER above) — it is used only
#      here, never by the API. ----
DATABASE_URL=postgres://glps:set me@db:5432/glps
MIGRATE_DB_PASSWORD=set me
APP_DB_PASSWORD=set me
# Seeds an instance admin and two demo guilds (Nightfall, Ironforge Guard),
# printing their credentials to the migrate service's logs. Leave false for
# a real deployment.
SEED_DEMO=false

# ---- api service: always connects as glps_app (RLS-enforced, not the table
#      owner — see §3A.3/§5). ----
DATABASE_URL_APP=postgres://glps_app:set me@db:5432/glps
JWT_SECRET=set me
TOKEN_PEPPER=set me
PUBLIC_BASE_URL=http://localhost:8080

# ---- Instance-wide defaults applied at guild creation only (§15/§3A.5).
#      Every one of these is actually a per-guild `guild_settings` row —
#      changing an env var here never alters an existing guild. The current
#      column defaults in apps/api/src/db/schema.ts already match the values
#      below; wiring INSTANCE_ADMIN guild provisioning to read these env
#      vars instead of the column defaults is open follow-up work. ----
EQUAL_DISTRIBUTION_MODE=PHASE
BIS_COUNT_SCOPE=PLAYER
BIS_COUNT_WEIGHT_MAIN=1
BIS_COUNT_WEIGHT_OFF=0
BIS_COUNT_WEIGHT_OVERRIDE=1
GUILD_LIST_VISIBILITY=AFTER_CLOSE
ALLOW_ALT_OFFSPEC_IN_OFF_LIST=true
TWOHAND_CONSUMES_OFFHAND=true
REQUIRE_FULL_LIST=false
FULFILL_CROSS_LIST=false
LIST_SIZE=17
